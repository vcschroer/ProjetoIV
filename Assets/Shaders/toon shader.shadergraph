    },
    "m_SourceType": 1,
    "m_FunctionName": "GetMainLight",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if defined(UNIVERSAL_LIGHTING_INCLUDED)\r\n    Light mainLight = GetMainLight(TransformWorldToShadowCoord(WorldPos));\r\n    Direction = mainLight.direction;\r\n    Color = mainLight.color;\r\n#else\r\n    Direction = float3(0.5, 0.5, -0.5);\r\n    Color = float3(1.0, 1.0, 1.0);\r\n#endif\n"
}

